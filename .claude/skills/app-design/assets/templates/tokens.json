{
  "$description": "Starter tokens for app-design. Replace the primitives with the chosen direction's palette; keep the semantic names. Default $value = light mode; other modes in $extensions.app-design.modes.",
  "color": {
    "primitive": {
      "neutral": {
        "0":    { "$type": "color", "$value": "#FFFFFF" },
        "50":   { "$type": "color", "$value": "#F6F6F7" },
        "100":  { "$type": "color", "$value": "#ECECEE" },
        "200":  { "$type": "color", "$value": "#D9D9DE" },
        "400":  { "$type": "color", "$value": "#9A9CA6" },
        "500":  { "$type": "color", "$value": "#6E7180" },
        "600":  { "$type": "color", "$value": "#555867" },
        "700":  { "$type": "color", "$value": "#3B3D48" },
        "800":  { "$type": "color", "$value": "#24252D" },
        "850":  { "$type": "color", "$value": "#1C1D23" },
        "900":  { "$type": "color", "$value": "#141519" },
        "950":  { "$type": "color", "$value": "#0C0C0F" },
        "1000": { "$type": "color", "$value": "#000000" }
      },
      "accent": {
        "400": { "$type": "color", "$value": "#6B9BFF" },
        "500": { "$type": "color", "$value": "#2F6BFF" },
        "600": { "$type": "color", "$value": "#1F55D6" },
        "700": { "$type": "color", "$value": "#1A43A8" }
      },
      "red":   { "400": { "$type": "color", "$value": "#FF8A80" }, "600": { "$type": "color", "$value": "#C62828" }, "800": { "$type": "color", "$value": "#8E1B1B" } },
      "green": { "400": { "$type": "color", "$value": "#6FD39A" }, "600": { "$type": "color", "$value": "#1E7F4A" }, "800": { "$type": "color", "$value": "#145534" } }
    },
    "surface": {
      "default": { "$type": "color", "$value": "{color.primitive.neutral.0}",
        "$extensions": { "app-design": { "modes": { "dark": "{color.primitive.neutral.950}", "dark-high-contrast": "{color.primitive.neutral.1000}" } } } },
      "raised": { "$type": "color", "$value": "{color.primitive.neutral.50}",
        "$extensions": { "app-design": { "modes": { "dark": "{color.primitive.neutral.850}" } } } },
      "sunken": { "$type": "color", "$value": "{color.primitive.neutral.100}",
        "$extensions": { "app-design": { "modes": { "dark": "{color.primitive.neutral.900}" } } } }
    },
    "text": {
      "primary": { "$type": "color", "$value": "{color.primitive.neutral.900}",
        "$extensions": { "app-design": { "modes": { "dark": "{color.primitive.neutral.50}", "high-contrast": "{color.primitive.neutral.1000}", "dark-high-contrast": "{color.primitive.neutral.0}" } } } },
      "secondary": { "$type": "color", "$value": "{color.primitive.neutral.600}",
        "$extensions": { "app-design": { "modes": { "dark": "{color.primitive.neutral.400}", "high-contrast": "{color.primitive.neutral.800}", "dark-high-contrast": "{color.primitive.neutral.100}" } } } },
      "disabled": { "$type": "color", "$value": "{color.primitive.neutral.400}",
        "$extensions": { "app-design": { "modes": { "dark": "{color.primitive.neutral.600}" } } } }
    },
    "border": {
      "subtle": { "$type": "color", "$value": "{color.primitive.neutral.100}",
        "$extensions": { "app-design": { "modes": { "dark": "{color.primitive.neutral.800}" } } } },
      "control": { "$type": "color", "$value": "{color.primitive.neutral.500}",
        "$extensions": { "app-design": { "modes": { "dark": "{color.primitive.neutral.500}", "high-contrast": "{color.primitive.neutral.900}", "dark-high-contrast": "{color.primitive.neutral.100}" } } } }
    },
    "action": {
      "primary": { "$type": "color", "$value": "{color.primitive.accent.600}",
        "$extensions": { "app-design": { "modes": { "dark": "{color.primitive.accent.400}", "high-contrast": "{color.primitive.accent.700}" } } } },
      "on-primary": { "$type": "color", "$value": "{color.primitive.neutral.0}",
        "$extensions": { "app-design": { "modes": { "dark": "{color.primitive.neutral.950}" } } } }
    },
    "focus": {
      "ring": { "$type": "color", "$value": "{color.primitive.accent.600}",
        "$extensions": { "app-design": { "modes": { "dark": "{color.primitive.accent.400}" } } } }
    },
    "status": {
      "danger": { "$type": "color", "$value": "{color.primitive.red.600}",
        "$extensions": { "app-design": { "modes": { "dark": "{color.primitive.red.400}", "high-contrast": "{color.primitive.red.800}" } } } },
      "success": { "$type": "color", "$value": "{color.primitive.green.600}",
        "$extensions": { "app-design": { "modes": { "dark": "{color.primitive.green.400}", "high-contrast": "{color.primitive.green.800}" } } } }
    }
  },
  "font": {
    "family": {
      "body":    { "$type": "fontFamily", "$value": ["-apple-system", "BlinkMacSystemFont", "Segoe UI Variable", "Roboto", "Inter", "system-ui", "sans-serif"] },
      "display": { "$type": "fontFamily", "$value": ["{font.family.body}"] },
      "mono":    { "$type": "fontFamily", "$value": ["SF Mono", "Cascadia Code", "Roboto Mono", "ui-monospace", "monospace"] }
    },
    "weight": {
      "regular":  { "$type": "fontWeight", "$value": 400 },
      "medium":   { "$type": "fontWeight", "$value": 500 },
      "semibold": { "$type": "fontWeight", "$value": 600 },
      "bold":     { "$type": "fontWeight", "$value": 700 }
    },
    "size": {
      "caption":  { "$type": "dimension", "$value": "12px" },
      "footnote": { "$type": "dimension", "$value": "13px" },
      "body":     { "$type": "dimension", "$value": "16px" },
      "headline": { "$type": "dimension", "$value": "17px" },
      "title-3":  { "$type": "dimension", "$value": "20px" },
      "title-2":  { "$type": "dimension", "$value": "22px" },
      "title-1":  { "$type": "dimension", "$value": "28px" },
      "large":    { "$type": "dimension", "$value": "34px" }
    }
  },
  "space": {
    "1": { "$type": "dimension", "$value": "4px" },
    "2": { "$type": "dimension", "$value": "8px" },
    "3": { "$type": "dimension", "$value": "12px" },
    "4": { "$type": "dimension", "$value": "16px" },
    "5": { "$type": "dimension", "$value": "20px" },
    "6": { "$type": "dimension", "$value": "24px" },
    "8": { "$type": "dimension", "$value": "32px" },
    "10": { "$type": "dimension", "$value": "40px" },
    "12": { "$type": "dimension", "$value": "48px" },
    "16": { "$type": "dimension", "$value": "64px" },
    "inset": {
      "screen": { "$type": "dimension", "$value": "{space.4}" },
      "card":   { "$type": "dimension", "$value": "{space.4}" }
    }
  },
  "radius": {
    "control": { "$type": "dimension", "$value": "10px" },
    "card":    { "$type": "dimension", "$value": "16px" },
    "sheet":   { "$type": "dimension", "$value": "28px" },
    "full":    { "$type": "dimension", "$value": "999px" }
  },
  "size": {
    "target-min": { "$type": "dimension", "$value": "44px", "$description": "44 pt Apple; use 48 dp on Android, 40 epx on Windows" }
  },
  "motion": {
    "duration": {
      "press":  { "$type": "duration", "$value": "120ms" },
      "fast":   { "$type": "duration", "$value": "180ms" },
      "medium": { "$type": "duration", "$value": "280ms" },
      "slow":   { "$type": "duration", "$value": "400ms" }
    },
    "easing": {
      "out":    { "$type": "cubicBezier", "$value": [0.23, 1, 0.32, 1] },
      "in-out": { "$type": "cubicBezier", "$value": [0.77, 0, 0.175, 1] }
    }
  },
  "$extensions": {
    "app-design": {
      "modes": ["light", "dark", "high-contrast", "dark-high-contrast"],
      "contrast": [
        { "fg": "color.text.primary",   "bg": "color.surface.default", "min": 4.5 },
        { "fg": "color.text.primary",   "bg": "color.surface.raised",  "min": 4.5 },
        { "fg": "color.text.secondary", "bg": "color.surface.default", "min": 4.5 },
        { "fg": "color.text.secondary", "bg": "color.surface.raised",  "min": 4.5 },
        { "fg": "color.action.on-primary", "bg": "color.action.primary", "min": 4.5 },
        { "fg": "color.action.primary", "bg": "color.surface.default", "min": 3 },
        { "fg": "color.border.control", "bg": "color.surface.default", "min": 3 },
        { "fg": "color.focus.ring",     "bg": "color.surface.default", "min": 3 },
        { "fg": "color.status.danger",  "bg": "color.surface.default", "min": 4.5 },
        { "fg": "color.status.success", "bg": "color.surface.default", "min": 4.5 }
      ]
    }
  }
}
